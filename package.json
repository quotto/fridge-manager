{
  "name": "fridge-manager-cloud",
  "version": "0.1.0",
  "private": true,
  "description": "食材在庫管理アプリの AWS CDK 基盤",
  "scripts": {
    "build": "tsc --noEmit",
    "lint": "eslint \"infra/**/*.ts\"",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "cdk": "cdk",
    "synth": "cdk synth",
    "cdk:synth": "cdk synth"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1110.0",
    "@aws-sdk/client-dynamodb": "^3.1110.0",
    "@aws-sdk/credential-provider-node": "3.972.79",
    "@smithy/core": "3.32.0",
    "@smithy/node-http-handler": "4.10.0",
    "@smithy/signature-v4": "5.7.0",
    "@types/aws-lambda": "^8.10.162",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "aws-cdk-lib": "^2.265.0",
    "constructs": "^10.8.1",
    "firebase-admin": "^14.2.0",
    "jpeg-js": "^0.4.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/jpeg-js": "^0.3.7",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.37.0",
    "aws-cdk": "^2.1136.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "uuid": "11.1.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/infra"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "infra/lib/**/*.ts",
      "infra/lambda/**/*.ts",
      "!infra/lambda/index.ts",
      "!infra/lambda/firebase-authorizer-index.ts",
      "!infra/lambda/ai-control-index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "plugins": [
      "@typescript-eslint"
    ],
    "extends": [
      "eslint:recommended",
      "plugin:@typescript-eslint/recommended"
    ],
    "parserOptions": {
      "project": "./tsconfig.json"
    },
    "ignorePatterns": [
      "cdk.out/",
      "coverage/"
    ]
  }
}
