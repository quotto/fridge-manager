{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "analysis-response.schema.json",
  "oneOf": [
    {
      "type": "object", "additionalProperties": false, "required": ["requestId","status","candidates","warnings"],
      "properties": {
        "requestId": { "type": "string", "format": "uuid" }, "status": { "const": "succeeded" },
        "candidates": { "type": "array", "maxItems": 30, "items": { "$ref": "#/$defs/candidate" } },
        "warnings": { "type": "array", "maxItems": 30, "items": { "type": "string", "maxLength": 100 } }
      }
    },
    {
      "type": "object", "additionalProperties": false, "required": ["status","error"],
      "properties": {
        "requestId": { "type": "string", "format": "uuid" }, "status": { "const": "failed" },
        "error": {
          "type": "object", "additionalProperties": false, "required": ["code","retryable"],
          "properties": {
            "code": { "enum": ["INVALID_REQUEST","INVALID_IMAGE","UNAUTHORIZED","DUPLICATE_REQUEST","IDEMPOTENCY_CONFLICT","TIMEOUT","PROVIDER_UNAVAILABLE","QUOTA_EXCEEDED","UNANALYZABLE_IMAGE","INTERNAL_ERROR"] },
            "retryable": { "type": "boolean" }, "retryAt": { "type": "string", "format": "date-time" }
          }
        }
      }
    }
  ],
  "$defs": {
    "candidate": {
      "type": "object", "additionalProperties": false, "required": ["name","quantity","unit","evidence","requiresReview"],
      "properties": {
        "name": { "type": ["string","null"], "maxLength": 30 },
        "quantity": { "type": ["string","null"], "pattern": "^(?:(?:0|[1-9][0-9]?)(?:\\.[0-9]{1,2})?|100)$" },
        "unit": { "type": ["string","null"], "enum": [null,"g","kg","ml","L","個","本","枚","袋","パック","箱","缶","瓶","束","株","玉","丁","尾","切れ","房","合","食"] },
        "evidence": { "enum": ["VISIBLE_COUNT","PACKAGE_LABEL","VISUAL_ESTIMATE","UNKNOWN"] },
        "requiresReview": { "type": "boolean" }
      }
    }
  }
}
